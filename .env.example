# majsqbot — copy to .env

# From @BotFather.
# ⚠️ Turn privacy mode OFF (/setprivacy → Disable) or the bot cannot read group
# messages, and the whole group experience silently does nothing.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Any long random string. Telegram echoes it back as the
# X-Telegram-Bot-Api-Secret-Token header on every webhook POST; updates without
# it are refused. Generate: python3 -c "import secrets;print(secrets.token_urlsafe(32))"
TELEGRAM_WEBHOOK_SECRET=

# The agent. Must match MAJSQ_SERVICE_SECRET in the agent's .env.
MAJSQ_AGENT_URL=http://localhost:8000
MAJSQ_SERVICE_SECRET=

# Where "open on the map" points.
MAJSQ_WEB_URL=http://localhost:3000

PORT=8080
